<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>CadAutomation.Inventor</RootNamespace>
    <AssemblyName>CadAutomation.Inventor</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <ComVisible>true</ComVisible>
    <Guid>8f2c7a1e-6b3d-4e1a-9c5f-2d7b4a8e1f60</Guid>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- Autodesk resmi NuGet paketi yayınlamadığı için Interop derlemesi yerel Inventor kurulumundan
         kopyalanıp lib/ altında tutuluyor. Private=true (CopyLocal): assembly, GAC'ta olmadığı için
         hem RegAsm'in hem de COM aktivasyonu sırasında CLR'nin bunu bulabilmesi için addin DLL'i ile
         aynı klasöre kopyalanması gerekiyor (standart Inventor addin dağıtım pratiği). -->
    <Reference Include="Autodesk.Inventor.Interop">
      <HintPath>..\..\lib\Autodesk.Inventor.Interop.dll</HintPath>
      <Private>true</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CadAutomation.Core\CadAutomation.Core.csproj" />
    <ProjectReference Include="..\CadAutomation.UI\CadAutomation.UI.csproj" />
  </ItemGroup>

</Project>
